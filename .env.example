# Template for a local .env file. See Docs/POSTGRES.md.
#
# These values are already the defaults compiled into configureDatabase, and they
# match docker-compose.yml, so a fresh clone needs no .env at all. Copy this file to
# .env only when you need to change something:
#
#   cp .env.example .env
#
# Vapor loads .env.<environment> and then .env at Application.make, using setenv with
# overwrite disabled. Real environment variables therefore always win, which is what
# lets CI and production configure themselves without a file.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=foobar
DATABASE_USERNAME=foobar
DATABASE_PASSWORD=foobar

# Set instead of the above to use a single connection string. Takes precedence.
# Append ?sslmode=disable when pointing at a local container, which offers no TLS.
# DATABASE_URL=postgres://foobar:foobar@localhost:5432/foobar

# The test suite connects to the db-test service, not db. Deliberately distinct names:
# reusing DATABASE_* would work but would depend on file-precedence rules to keep a
# test run off your development data, and a wrong answer there truncates the wrong
# database.
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5433
